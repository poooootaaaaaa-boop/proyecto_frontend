  --brand-primary: #2563eb;
  --brand-hover: #1d4ed8;
  --brand-light: #eff6ff;

  --status-routine-bg: #eff6ff;
  --status-routine-text: #2563eb;

  --status-follow-bg: #ecfdf5;
