.prio-badge { display: inline-block; padding: 2px 10px; border-radius: 3px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-left: 8px; }
.prio-alta  { background: #f8d7da; color: #721c24; }
