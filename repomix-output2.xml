<file path="src/pages/farmacia/personal/Tabhorarios.jsx">
import { useCallback, useEffect, useState } from "react";
import axios from "axios";
import { Badge, Button, Modal, Spinner, Form } from "react-bootstrap";
import { DIAS, PERSONAL_URL, errMsg, hhmm, horasBloque, iniciales, useAviso } from "./Personalutils.js";
import { Aviso, Cargando, Vacio } from "../Compartidos.jsx";

/** CLIC-387 · Registrar horarios */
const BLOQUE_DEFAULT = { inicio: "08:00", fin: "16:00" };

const vacioSemana = () => Object.fromEntries(DIAS.map((d) => [d.n, []]));

const horasSemana = (horarios) =>
  horarios.reduce((t, h) => t + horasBloque(h.hora_inicio, h.hora_fin), 0);

const fmtHoras = (h) => (Number.isInteger(h) ? `${h} h` : `${h.toFixed(1)} h`);

export default function TabHorarios({ clinicaId, onCambio }) {
  const [empleados, setEmpleados] = useState([]);
  const [loading, setLoading] = useState(true);

  const [editando, setEditando] = useState(null);
  const [semana, setSemana] = useState(vacioSemana());
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState("");
  const { aviso, ok, error, limpiar } = useAviso();

  const cargar = useCallback(async () => {
    try {
      const { data } = await axios.get(`${PERSONAL_URL}/horarios`, { params: { clinica_id: clinicaId } });
      setEmpleados(data);
    } catch (err) {
      error(err);
    } finally {
      setLoading(false);
    }
  }, [clinicaId, error]);

  useEffect(() => {
    cargar();
  }, [cargar]);

  const abrir = (emp) => {
    const s = vacioSemana();
    emp.horarios.forEach((h) => s[h.dia_semana].push({ inicio: hhmm(h.hora_inicio), fin: hhmm(h.hora_fin) }));
    setSemana(s);
    setFormError("");
    setEditando(emp);
  };

  const cerrar = () => setEditando(null);

  const alternarDia = (n, activo) =>
    setSemana((s) => ({ ...s, [n]: activo ? [{ ...BLOQUE_DEFAULT }] : [] }));

  const cambiarBloque = (n, i, campo, valor) =>
    setSemana((s) => ({ ...s, [n]: s[n].map((b, j) => (j === i ? { ...b, [campo]: valor } : b)) }));

  const agregarBloque = (n) =>
    setSemana((s) => ({ ...s, [n]: [...s[n], { inicio: "16:00", fin: "20:00" }] }));

  const quitarBloque = (n, i) =>
    setSemana((s) => ({ ...s, [n]: s[n].filter((_, j) => j !== i) }));

  const aplicarLunesViernes = () =>
    setSemana((s) => {
      const base = s[1][0] || BLOQUE_DEFAULT;
      return Object.fromEntries(
        DIAS.map((d) => [d.n, d.n <= 5 ? [{ ...base }] : []])
      );
    });

  const aplanar = () =>
    DIAS.flatMap((d) =>
      semana[d.n].map((b) => ({ dia_semana: d.n, hora_inicio: b.inicio, hora_fin: b.fin }))
    );

  const totalEditor = aplanar().reduce((t, h) => t + horasBloque(h.hora_inicio, h.hora_fin), 0);

  const guardar = async () => {
    const horarios = aplanar();
    if (horarios.some((h) => !h.hora_inicio || !h.hora_fin)) {
      setFormError("Completa la hora de inicio y fin de todos los turnos.");
      return;
    }
    if (horarios.some((h) => h.hora_inicio === h.hora_fin)) {
      setFormError("La hora de inicio y fin no pueden ser iguales.");
      return;
    }

    setSaving(true);
    try {
      await axios.put(`${PERSONAL_URL}/empleados/${editando.id}/horarios`, {
        clinica_id: clinicaId,
        horarios,
      });
      ok(`Horario de ${editando.nombre_completo} guardado.`);
      cerrar();
      cargar();
      onCambio?.();
    } catch (err) {
      setFormError(errMsg(err));
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="gp-panel">
      <div className="gp-toolbar">
        <div>
          <h5 className="gp-title">Horarios</h5>
          <small className="text-muted">Horario semanal del personal activo. Se permiten turnos nocturnos (ej. 22:00 – 06:00).</small>
        </div>
      </div>

      <Aviso aviso={aviso} onClose={limpiar} />

      {loading ? (
        <Cargando />
      ) : empleados.length === 0 ? (
        <Vacio icono="bi-clock" texto="No hay empleados activos. Registra empleados primero." />
      ) : (
        <div className="gp-table-wrap">
          <table className="gp-table gp-horarios">
            <thead>
              <tr>
                <th>Empleado</th>
                {DIAS.map((d) => (
                  <th key={d.n} className="text-center">
                    {d.corto}
                  </th>
                ))}
                <th className="text-center">Total</th>
                <th className="text-end"></th>
              </tr>
            </thead>
            <tbody>
              {empleados.map((e) => (
                <tr key={e.id}>
                  <td>
                    <div className="gp-persona">
                      <span className="gp-avatar">{iniciales(e.nombre, e.apellidos)}</span>
                      <div>
                        <div className="fw-semibold">{e.nombre_completo}</div>
                        <small className="gp-muted">{e.puesto?.nombre || "Sin puesto"}</small>
                      </div>
                    </div>
                  </td>
                  {DIAS.map((d) => {
                    const bloques = e.horarios.filter((h) => h.dia_semana === d.n);
                    return (
                      <td key={d.n} className="text-center">
                        {bloques.length === 0 ? (
                          <span className="gp-muted">—</span>
                        ) : (
                          bloques.map((b) => (
                            <div key={b.id} className="gp-turno">
                              {hhmm(b.hora_inicio)}–{hhmm(b.hora_fin)}
                            </div>
                          ))
                        )}
                      </td>
                    );
                  })}
                  <td className="text-center">
                    {e.horarios.length === 0 ? (
                      <Badge bg="warning" text="dark">Sin horario</Badge>
                    ) : (
                      <strong>{fmtHoras(horasSemana(e.horarios))}</strong>
                    )}
                  </td>
                  <td className="text-end">
                    <Button size="sm" variant="light" onClick={() => abrir(e)} title="Editar horario">
                      <i className="bi bi-pencil-square"></i>
                    </Button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* EDITOR */}
      <Modal show={!!editando} onHide={cerrar} size="lg" centered scrollable>
        <Modal.Header closeButton>
          <Modal.Title>Horario · {editando?.nombre_completo}</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {formError && <div className="alert alert-danger py-2">{formError}</div>}

          <div className="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <Button size="sm" variant="outline-primary" onClick={aplicarLunesViernes}>
              Aplicar lunes a viernes {(semana[1][0] || BLOQUE_DEFAULT).inicio}–{(semana[1][0] || BLOQUE_DEFAULT).fin}
            </Button>
            <span className="gp-muted">
              Total semanal: <strong>{fmtHoras(totalEditor)}</strong>
            </span>
          </div>

          {DIAS.map((d) => (
            <div key={d.n} className="gp-dia-row">
              <Form.Check
                type="switch"
                id={`dia-${d.n}`}
                className="gp-dia-nombre"
                label={d.largo}
                checked={semana[d.n].length > 0}
                onChange={(e) => alternarDia(d.n, e.target.checked)}
              />
              <div className="gp-dia-bloques">
                {semana[d.n].length === 0 ? (
                  <span className="gp-muted">Descanso</span>
                ) : (
                  semana[d.n].map((b, i) => (
                    <div key={i} className="gp-bloque">
                      <Form.Control type="time" size="sm" value={b.inicio} onChange={(e) => cambiarBloque(d.n, i, "inicio", e.target.value)} />
                      <span>a</span>
                      <Form.Control type="time" size="sm" value={b.fin} onChange={(e) => cambiarBloque(d.n, i, "fin", e.target.value)} />
                      {semana[d.n].length > 1 && (
                        <Button size="sm" variant="outline-danger" onClick={() => quitarBloque(d.n, i)} title="Quitar turno">
                          <i className="bi bi-x-lg"></i>
                        </Button>
                      )}
                    </div>
                  ))
                )}
                {semana[d.n].length > 0 && semana[d.n].length < 3 && (
                  <Button size="sm" variant="link" className="p-0" onClick={() => agregarBloque(d.n)}>
                    + turno
                  </Button>
                )}
              </div>
            </div>
          ))}
        </Modal.Body>
        <Modal.Footer>
          <Button variant="outline-secondary" onClick={cerrar} disabled={saving}>
            Cancelar
          </Button>
          <Button onClick={guardar} disabled={saving}>
            {saving ? <Spinner size="sm" /> : "Guardar horario"}
          </Button>
        </Modal.Footer>
      </Modal>
    </div>
  );
}
</file>

<file path="src/pages/farmacia/personal/Tabpermisos.jsx">
import { useCallback, useEffect, useState } from "react";
import axios from "axios";
import { Badge, Button, Col, Form, Modal, Row, Spinner } from "react-bootstrap";
import {
  ESTADOS_SOLICITUD,
  PERSONAL_URL,
  TIPOS_PERMISO,
  errMsg,
  fmtRango,
  getUsuario,
  useAviso,
  useEmpleados,
} from "./Personalutils.js";
import { Aviso, Cargando, ResolverModal, Vacio } from "../Compartidos.jsx";

/** CLIC-388 · Registrar permisos */
const hoy = () => new Date().toISOString().slice(0, 10);
const VACIO = { empleado_id: "", tipo: "personal", fecha_inicio: "", fecha_fin: "", con_goce_sueldo: true, motivo: "" };

const diasNaturales = (ini, fin) =>
  ini && fin && fin >= ini ? Math.round((new Date(fin) - new Date(ini)) / 86400000) + 1 : 0;

export default function TabPermisos({ clinicaId, onCambio }) {
  const usuario = getUsuario();
  const { empleados } = useEmpleados(clinicaId, "activo");

  const [permisos, setPermisos] = useState([]);
  const [loading, setLoading] = useState(true);
  const [filtroEstado, setFiltroEstado] = useState("");
  const [filtroEmpleado, setFiltroEmpleado] = useState("");

  const [showForm, setShowForm] = useState(false);
  const [form, setForm] = useState(VACIO);
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState("");

  const [resolver, setResolver] = useState(null); // { permiso, accion }
  const { aviso, ok, error, limpiar } = useAviso();

  const cargar = useCallback(async () => {
    try {
      const { data } = await axios.get(`${PERSONAL_URL}/permisos`, {
        params: {
          clinica_id: clinicaId,
          estado: filtroEstado || undefined,
          empleado_id: filtroEmpleado || undefined,
        },
      });
      setPermisos(data);
    } catch (err) {
      error(err);
    } finally {
      setLoading(false);
    }
  }, [clinicaId, filtroEstado, filtroEmpleado, error]);

  useEffect(() => {
    cargar();
  }, [cargar]);

  const abrirNuevo = () => {
    setForm({ ...VACIO, fecha_inicio: hoy(), fecha_fin: hoy() });
    setFormError("");
    setShowForm(true);
  };

  const cambiar = (e) => {
    const { name, value, type, checked } = e.target;
    setForm((f) => {
      const next = { ...f, [name]: type === "checkbox" ? checked : value };
      if (name === "fecha_inicio" && next.fecha_fin < value) next.fecha_fin = value;
      return next;
    });
    setFormError("");
  };

  const guardar = async () => {
    if (!form.empleado_id || !form.fecha_inicio || !form.fecha_fin) {
      setFormError("Selecciona el empleado y las fechas del permiso.");
      return;
    }
    if (form.fecha_fin < form.fecha_inicio) {
      setFormError("La fecha fin no puede ser anterior a la de inicio.");
      return;
    }

    setSaving(true);
    try {
      await axios.post(`${PERSONAL_URL}/permisos`, { ...form, clinica_id: clinicaId });
      ok("Permiso registrado. Queda pendiente de aprobación.");
      setShowForm(false);
      cargar();
      onCambio?.();
    } catch (err) {
      setFormError(errMsg(err));
    } finally {
      setSaving(false);
    }
  };

  const confirmarResolver = async (observaciones) => {
    setSaving(true);
    try {
      await axios.post(`${PERSONAL_URL}/permisos/${resolver.permiso.id}/resolver`, {
        clinica_id: clinicaId,
        estado: resolver.accion,
        observaciones: observaciones || null,
        registrado_por: usuario?.id ?? null,
      });
      ok(`Permiso ${resolver.accion}.`);
      setResolver(null);
      cargar();
      onCambio?.();
    } catch (err) {
      setResolver(null);
      error(err);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="gp-panel">
      <div className="gp-toolbar">
        <div>
          <h5 className="gp-title">Permisos</h5>
          <small className="text-muted">Solicitudes de permiso del personal y su aprobación</small>
        </div>
        <Button onClick={abrirNuevo} disabled={empleados.length === 0}>
          <i className="bi bi-plus-circle me-2"></i>Nuevo permiso
        </Button>
      </div>

      <Aviso aviso={aviso} onClose={limpiar} />

      <Row className="g-2 mb-3">
        <Col md={5}>
          <Form.Select value={filtroEmpleado} onChange={(e) => setFiltroEmpleado(e.target.value)}>
            <option value="">Todos los empleados</option>
            {empleados.map((e) => (
              <option key={e.id} value={e.id}>
                {e.nombre_completo}
              </option>
            ))}
          </Form.Select>
        </Col>
        <Col md={3}>
          <Form.Select value={filtroEstado} onChange={(e) => setFiltroEstado(e.target.value)}>
            <option value="">Todos los estados</option>
            {Object.entries(ESTADOS_SOLICITUD).map(([k, v]) => (
              <option key={k} value={k}>
                {v.label}
              </option>
            ))}
          </Form.Select>
        </Col>
      </Row>

      {loading ? (
        <Cargando />
      ) : permisos.length === 0 ? (
        <Vacio icono="bi-file-earmark-check" texto="No hay permisos registrados." />
      ) : (
        <div className="gp-table-wrap">
          <table className="gp-table">
            <thead>
              <tr>
                <th>Empleado</th>
                <th>Tipo</th>
                <th>Fechas</th>
                <th>Días</th>
                <th>Estado</th>
                <th>Motivo / observaciones</th>
                <th className="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {permisos.map((p) => {
                const est = ESTADOS_SOLICITUD[p.estado];
                return (
                  <tr key={p.id}>
                    <td>
                      <div className="fw-semibold">{p.empleado?.nombre_completo}</div>
                      <small className="gp-muted">{p.empleado?.puesto?.nombre || p.empleado?.numero_empleado}</small>
                    </td>
                    <td>
                      {TIPOS_PERMISO[p.tipo]}
                      <br />
                      <small className="gp-muted">{p.con_goce_sueldo ? "Con goce de sueldo" : "Sin goce de sueldo"}</small>
                    </td>
                    <td>{fmtRango(p.fecha_inicio, p.fecha_fin)}</td>
                    <td>{p.dias}</td>
                    <td>
                      <Badge bg={est.bg} text={est.text}>{est.label}</Badge>
                    </td>
                    <td className="gp-muted gp-wrap">
                      {p.motivo || "—"}
                      {p.observaciones && (
                        <div>
                          <em>{p.observaciones}</em>
                        </div>
                      )}
                    </td>
                    <td className="text-end gp-acciones">
                      {p.estado === "pendiente" && (
                        <>
                          <Button size="sm" variant="success" title="Aprobar" onClick={() => setResolver({ permiso: p, accion: "aprobado" })}>
                            <i className="bi bi-check-lg"></i>
                          </Button>
                          <Button size="sm" variant="danger" title="Rechazar" onClick={() => setResolver({ permiso: p, accion: "rechazado" })}>
                            <i className="bi bi-x-lg"></i>
                          </Button>
                        </>
                      )}
                      {(p.estado === "pendiente" || p.estado === "aprobado") && (
                        <Button size="sm" variant="outline-secondary" title="Cancelar" onClick={() => setResolver({ permiso: p, accion: "cancelado" })}>
                          <i className="bi bi-slash-circle"></i>
                        </Button>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}

      {/* NUEVO PERMISO */}
      <Modal show={showForm} onHide={() => setShowForm(false)} centered>
        <Modal.Header closeButton>
          <Modal.Title>Nuevo permiso</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {formError && <div className="alert alert-danger py-2">{formError}</div>}
          <Form.Group className="mb-3">
            <Form.Label>Empleado *</Form.Label>
            <Form.Select name="empleado_id" value={form.empleado_id} onChange={cambiar}>
              <option value="">Selecciona…</option>
              {empleados.map((e) => (
                <option key={e.id} value={e.id}>
                  {e.nombre_completo} · {e.numero_empleado}
                </option>
              ))}
            </Form.Select>
          </Form.Group>
          <Form.Group className="mb-3">
            <Form.Label>Tipo de permiso *</Form.Label>
            <Form.Select name="tipo" value={form.tipo} onChange={cambiar}>
              {Object.entries(TIPOS_PERMISO).map(([k, v]) => (
                <option key={k} value={k}>
                  {v}
                </option>
              ))}
            </Form.Select>
          </Form.Group>
          <Row className="g-3 mb-3">
            <Col>
              <Form.Label>Desde *</Form.Label>
              <Form.Control type="date" name="fecha_inicio" value={form.fecha_inicio} onChange={cambiar} />
            </Col>
            <Col>
              <Form.Label>Hasta *</Form.Label>
              <Form.Control type="date" name="fecha_fin" min={form.fecha_inicio} value={form.fecha_fin} onChange={cambiar} />
            </Col>
          </Row>
          <p className="gp-muted mb-3">
            Duración: <strong>{diasNaturales(form.fecha_inicio, form.fecha_fin)}</strong> día(s) naturales
          </p>
          <Form.Check
            type="switch"
            id="permiso-goce"
            name="con_goce_sueldo"
            label="Con goce de sueldo"
            className="mb-3"
            checked={form.con_goce_sueldo}
            onChange={cambiar}
          />
          <Form.Group>
            <Form.Label>Motivo</Form.Label>
            <Form.Control as="textarea" rows={3} name="motivo" value={form.motivo} onChange={cambiar} maxLength={1000} />
          </Form.Group>
        </Modal.Body>
        <Modal.Footer>
          <Button variant="outline-secondary" onClick={() => setShowForm(false)} disabled={saving}>
            Cancelar
          </Button>
          <Button onClick={guardar} disabled={saving}>
            {saving ? <Spinner size="sm" /> : "Registrar permiso"}
          </Button>
        </Modal.Footer>
      </Modal>

      <ResolverModal
        show={!!resolver}
        accion={resolver?.accion}
        busy={saving}
        resumen={
          resolver &&
          `${resolver.permiso.empleado?.nombre_completo} · ${TIPOS_PERMISO[resolver.permiso.tipo]} · ${fmtRango(
            resolver.permiso.fecha_inicio,
            resolver.permiso.fecha_fin
          )}`
        }
        onHide={() => setResolver(null)}
        onConfirm={confirmarResolver}
      />
    </div>
  );
}
</file>

<file path="src/pages/farmacia/personal/Tabpuestos.jsx">
import { useCallback, useEffect, useState } from "react";
import axios from "axios";
import { Badge, Button, Form, Modal, Spinner } from "react-bootstrap";
import { PERSONAL_URL, errMsg, fmtMoney, useAviso } from "./Personalutils.js";
import { Aviso, Cargando, Vacio } from "../Compartidos.jsx";

/** CLIC-386 · Registrar puesto */
const VACIO = { nombre: "", descripcion: "", salario_base: "", activo: true };

export default function TabPuestos({ clinicaId, onCambio }) {
  const [puestos, setPuestos] = useState([]);
  const [loading, setLoading] = useState(true);
  const [modal, setModal] = useState({ show: false, editando: null });
  const [form, setForm] = useState(VACIO);
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState("");
  const [borrar, setBorrar] = useState(null);
  const { aviso, ok, error, limpiar } = useAviso();

  const cargar = useCallback(async () => {
    try {
      const { data } = await axios.get(`${PERSONAL_URL}/puestos`, { params: { clinica_id: clinicaId } });
      setPuestos(data);
    } catch (err) {
      error(err);
    } finally {
      setLoading(false);
    }
  }, [clinicaId, error]);

  useEffect(() => {
    cargar();
  }, [cargar]);

  const abrirNuevo = () => {
    setForm(VACIO);
    setFormError("");
    setModal({ show: true, editando: null });
  };

  const abrirEditar = (p) => {
    setForm({
      nombre: p.nombre,
      descripcion: p.descripcion || "",
      salario_base: p.salario_base ?? "",
      activo: !!p.activo,
    });
    setFormError("");
    setModal({ show: true, editando: p });
  };

  const cerrar = () => setModal({ show: false, editando: null });
  const cambiar = (e) => {
    const { name, value, type, checked } = e.target;
    setForm((f) => ({ ...f, [name]: type === "checkbox" ? checked : value }));
    setFormError("");
  };

  const guardar = async () => {
    if (!form.nombre.trim()) {
      setFormError("El nombre del puesto es obligatorio.");
      return;
    }

    const payload = {
      clinica_id: clinicaId,
      nombre: form.nombre.trim(),
      descripcion: form.descripcion.trim() || null,
      salario_base: form.salario_base === "" ? null : form.salario_base,
      activo: form.activo,
    };

    setSaving(true);
    try {
      if (modal.editando) {
        await axios.put(`${PERSONAL_URL}/puestos/${modal.editando.id}`, payload);
        ok("Puesto actualizado.");
      } else {
        await axios.post(`${PERSONAL_URL}/puestos`, payload);
        ok("Puesto registrado.");
      }
      cerrar();
      cargar();
      onCambio?.();
    } catch (err) {
      setFormError(errMsg(err));
    } finally {
      setSaving(false);
    }
  };

  const eliminar = async () => {
    try {
      await axios.delete(`${PERSONAL_URL}/puestos/${borrar.id}`, { params: { clinica_id: clinicaId } });
      ok("Puesto eliminado.");
      setBorrar(null);
      cargar();
    } catch (err) {
      setBorrar(null);
      error(err);
    }
  };

  return (
    <div className="gp-panel">
      <div className="gp-toolbar">
        <div>
          <h5 className="gp-title">Puestos</h5>
          <small className="text-muted">Catálogo de puestos de la clínica</small>
        </div>
        <Button onClick={abrirNuevo}>
          <i className="bi bi-plus-circle me-2"></i>Nuevo puesto
        </Button>
      </div>

      <Aviso aviso={aviso} onClose={limpiar} />

      {loading ? (
        <Cargando />
      ) : puestos.length === 0 ? (
        <Vacio icono="bi-briefcase" texto="Aún no hay puestos registrados." />
      ) : (
        <div className="gp-table-wrap">
          <table className="gp-table">
            <thead>
              <tr>
                <th>Puesto</th>
                <th>Descripción</th>
                <th>Salario base</th>
                <th>Empleados activos</th>
                <th>Estado</th>
                <th className="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {puestos.map((p) => (
                <tr key={p.id}>
                  <td className="fw-semibold">{p.nombre}</td>
                  <td className="gp-muted">{p.descripcion || "—"}</td>
                  <td>{fmtMoney(p.salario_base)}</td>
                  <td>{p.empleados_activos}</td>
                  <td>
                    <Badge bg={p.activo ? "success" : "secondary"}>{p.activo ? "Activo" : "Inactivo"}</Badge>
                  </td>
                  <td className="text-end">
                    <Button size="sm" variant="light" className="me-1" onClick={() => abrirEditar(p)} title="Editar">
                      <i className="bi bi-pencil-square"></i>
                    </Button>
                    <Button size="sm" variant="outline-danger" onClick={() => setBorrar(p)} title="Eliminar">
                      <i className="bi bi-trash"></i>
                    </Button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* MODAL CREAR / EDITAR */}
      <Modal show={modal.show} onHide={cerrar} centered>
        <Modal.Header closeButton>
          <Modal.Title>{modal.editando ? "Editar puesto" : "Nuevo puesto"}</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {formError && <div className="alert alert-danger py-2">{formError}</div>}
          <Form.Group className="mb-3">
            <Form.Label>Nombre *</Form.Label>
            <Form.Control name="nombre" value={form.nombre} onChange={cambiar} maxLength={100} />
          </Form.Group>
          <Form.Group className="mb-3">
            <Form.Label>Descripción</Form.Label>
            <Form.Control as="textarea" rows={3} name="descripcion" value={form.descripcion} onChange={cambiar} />
          </Form.Group>
          <Form.Group className="mb-3">
            <Form.Label>Salario base mensual (MXN)</Form.Label>
            <Form.Control type="number" min="0" step="0.01" name="salario_base" value={form.salario_base} onChange={cambiar} />
          </Form.Group>
          <Form.Check type="switch" id="puesto-activo" name="activo" label="Puesto activo" checked={form.activo} onChange={cambiar} />
        </Modal.Body>
        <Modal.Footer>
          <Button variant="outline-secondary" onClick={cerrar} disabled={saving}>
            Cancelar
          </Button>
          <Button onClick={guardar} disabled={saving}>
            {saving ? <Spinner size="sm" /> : "Guardar"}
          </Button>
        </Modal.Footer>
      </Modal>

      {/* MODAL ELIMINAR */}
      <Modal show={!!borrar} onHide={() => setBorrar(null)} centered>
        <Modal.Header closeButton>
          <Modal.Title>Eliminar puesto</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          ¿Eliminar el puesto <strong>{borrar?.nombre}</strong>? Si tiene empleados asignados no se podrá eliminar;
          en ese caso desactívalo.
        </Modal.Body>
        <Modal.Footer>
          <Button variant="secondary" onClick={() => setBorrar(null)}>
            Cancelar
          </Button>
          <Button variant="danger" onClick={eliminar}>
            Eliminar
          </Button>
        </Modal.Footer>
      </Modal>
    </div>
  );
}
</file>

<file path="src/pages/farmacia/personal/Tabvacaciones.jsx">
import { useCallback, useEffect, useState } from "react";
import axios from "axios";
import { Badge, Button, Col, Form, Modal, Row, Spinner } from "react-bootstrap";
import {
  ESTADOS_SOLICITUD,
  PERSONAL_URL,
  errMsg,
  fmtFecha,
  fmtRango,
  getUsuario,
  useAviso,
  useEmpleados,
} from "./Personalutils.js";
import { Aviso, Cargando, ResolverModal, Vacio } from "../Compartidos.jsx";

/** CLIC-389 · Registrar vacaciones */
const hoy = () => new Date().toISOString().slice(0, 10);
const VACIO = { empleado_id: "", fecha_inicio: "", fecha_fin: "", comentarios: "" };

export default function TabVacaciones({ clinicaId, onCambio }) {
  const usuario = getUsuario();
  const { empleados } = useEmpleados(clinicaId, "activo");

  const [vacaciones, setVacaciones] = useState([]);
  const [loading, setLoading] = useState(true);
  const [filtroEstado, setFiltroEstado] = useState("");
  const [filtroEmpleado, setFiltroEmpleado] = useState("");

  const [showForm, setShowForm] = useState(false);
  const [form, setForm] = useState(VACIO);
  const [saldo, setSaldo] = useState(null);
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState("");

  const [resolver, setResolver] = useState(null);
  const { aviso, ok, error, limpiar } = useAviso();

  const cargar = useCallback(async () => {
    try {
      const { data } = await axios.get(`${PERSONAL_URL}/vacaciones`, {
        params: {
          clinica_id: clinicaId,
          estado: filtroEstado || undefined,
          empleado_id: filtroEmpleado || undefined,
        },
      });
      setVacaciones(data);
    } catch (err) {
      error(err);
    } finally {
      setLoading(false);
    }
  }, [clinicaId, filtroEstado, filtroEmpleado, error]);

  useEffect(() => {
    cargar();
  }, [cargar]);

  // saldo del empleado seleccionado en el formulario
  useEffect(() => {
    if (!showForm || !form.empleado_id) {
      setSaldo(null);
      return;
    }
    let cancelado = false;
    axios
      .get(`${PERSONAL_URL}/empleados/${form.empleado_id}/vacaciones-saldo`, { params: { clinica_id: clinicaId } })
      .then(({ data }) => !cancelado && setSaldo(data))
      .catch(() => !cancelado && setSaldo(null));
    return () => {
      cancelado = true;
    };
  }, [showForm, form.empleado_id, clinicaId]);

  const abrirNuevo = () => {
    setForm({ ...VACIO, fecha_inicio: hoy(), fecha_fin: hoy() });
    setSaldo(null);
    setFormError("");
    setShowForm(true);
  };

  const cambiar = (e) => {
    const { name, value } = e.target;
    setForm((f) => {
      const next = { ...f, [name]: value };
      if (name === "fecha_inicio" && next.fecha_fin < value) next.fecha_fin = value;
      return next;
    });
    setFormError("");
  };

  const guardar = async () => {
    if (!form.empleado_id || !form.fecha_inicio || !form.fecha_fin) {
      setFormError("Selecciona el empleado y las fechas de las vacaciones.");
      return;
    }
    setSaving(true);
    try {
      const { data } = await axios.post(`${PERSONAL_URL}/vacaciones`, { ...form, clinica_id: clinicaId });
      ok(data.message);
      setShowForm(false);
      cargar();
      onCambio?.();
    } catch (err) {
      setFormError(errMsg(err));
    } finally {
      setSaving(false);
    }
  };

  const confirmarResolver = async (observaciones) => {
    setSaving(true);
    try {
      await axios.post(`${PERSONAL_URL}/vacaciones/${resolver.vacacion.id}/resolver`, {
        clinica_id: clinicaId,
        estado: resolver.accion,
        observaciones: observaciones || null,
        registrado_por: usuario?.id ?? null,
      });
      ok(`Vacaciones ${{ aprobado: "aprobadas", rechazado: "rechazadas", cancelado: "canceladas" }[resolver.accion]}.`);
      setResolver(null);
      cargar();
      onCambio?.();
    } catch (err) {
      setResolver(null);
      error(err);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="gp-panel">
      <div className="gp-toolbar">
        <div>
          <h5 className="gp-title">Vacaciones</h5>
          <small className="text-muted">Días según antigüedad (Ley Federal del Trabajo) y control de solicitudes</small>
        </div>
        <Button onClick={abrirNuevo} disabled={empleados.length === 0}>
          <i className="bi bi-plus-circle me-2"></i>Registrar vacaciones
        </Button>
      </div>

      <Aviso aviso={aviso} onClose={limpiar} />

      <Row className="g-2 mb-3">
        <Col md={5}>
          <Form.Select value={filtroEmpleado} onChange={(e) => setFiltroEmpleado(e.target.value)}>
            <option value="">Todos los empleados</option>
            {empleados.map((e) => (
              <option key={e.id} value={e.id}>
                {e.nombre_completo}
              </option>
            ))}
          </Form.Select>
        </Col>
        <Col md={3}>
          <Form.Select value={filtroEstado} onChange={(e) => setFiltroEstado(e.target.value)}>
            <option value="">Todos los estados</option>
            {Object.entries(ESTADOS_SOLICITUD).map(([k, v]) => (
              <option key={k} value={k}>
                {v.label}
              </option>
            ))}
          </Form.Select>
        </Col>
      </Row>

      {loading ? (
        <Cargando />
      ) : vacaciones.length === 0 ? (
        <Vacio icono="bi-sun" texto="No hay vacaciones registradas." />
      ) : (
        <div className="gp-table-wrap">
          <table className="gp-table">
            <thead>
              <tr>
                <th>Empleado</th>
                <th>Fechas</th>
                <th>Días lab.</th>
                <th>Periodo</th>
                <th>Estado</th>
                <th>Comentarios / observaciones</th>
                <th className="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {vacaciones.map((v) => {
                const est = ESTADOS_SOLICITUD[v.estado];
                return (
                  <tr key={v.id}>
                    <td>
                      <div className="fw-semibold">{v.empleado?.nombre_completo}</div>
                      <small className="gp-muted">{v.empleado?.puesto?.nombre || v.empleado?.numero_empleado}</small>
                    </td>
                    <td>{fmtRango(v.fecha_inicio, v.fecha_fin)}</td>
                    <td>{v.dias}</td>
                    <td>
                      {v.periodo} año{v.periodo === 1 ? "" : "s"} de antigüedad
                    </td>
                    <td>
                      <Badge bg={est.bg} text={est.text}>{est.label}</Badge>
                    </td>
                    <td className="gp-muted gp-wrap">
                      {v.comentarios || "—"}
                      {v.observaciones && (
                        <div>
                          <em>{v.observaciones}</em>
                        </div>
                      )}
                    </td>
                    <td className="text-end gp-acciones">
                      {v.estado === "pendiente" && (
                        <>
                          <Button size="sm" variant="success" title="Aprobar" onClick={() => setResolver({ vacacion: v, accion: "aprobado" })}>
                            <i className="bi bi-check-lg"></i>
                          </Button>
                          <Button size="sm" variant="danger" title="Rechazar" onClick={() => setResolver({ vacacion: v, accion: "rechazado" })}>
                            <i className="bi bi-x-lg"></i>
                          </Button>
                        </>
                      )}
                      {(v.estado === "pendiente" || v.estado === "aprobado") && (
                        <Button size="sm" variant="outline-secondary" title="Cancelar" onClick={() => setResolver({ vacacion: v, accion: "cancelado" })}>
                          <i className="bi bi-slash-circle"></i>
                        </Button>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}

      {/* REGISTRAR VACACIONES */}
      <Modal show={showForm} onHide={() => setShowForm(false)} centered>
        <Modal.Header closeButton>
          <Modal.Title>Registrar vacaciones</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {formError && <div className="alert alert-danger py-2">{formError}</div>}

          <Form.Group className="mb-3">
            <Form.Label>Empleado *</Form.Label>
            <Form.Select name="empleado_id" value={form.empleado_id} onChange={cambiar}>
              <option value="">Selecciona…</option>
              {empleados.map((e) => (
                <option key={e.id} value={e.id}>
                  {e.nombre_completo} · {e.numero_empleado}
                </option>
              ))}
            </Form.Select>
          </Form.Group>

          {saldo && (
            <div className="gp-saldo">
              <div>
                <small>Antigüedad</small>
                <strong>{saldo.antiguedad_anios} año(s)</strong>
              </div>
              <div>
                <small>Derecho</small>
                <strong>{saldo.derecho} días</strong>
              </div>
              <div>
                <small>Aprobados</small>
                <strong>{saldo.tomados}</strong>
              </div>
              <div>
                <small>Pendientes</small>
                <strong>{saldo.pendientes}</strong>
              </div>
              <div className="gp-saldo-disp">
                <small>Disponibles</small>
                <strong>{saldo.disponibles}</strong>
              </div>
            </div>
          )}
          {saldo && saldo.derecho === 0 && (
            <p className="gp-muted small">
              Aún no cumple 1 año de antigüedad; el derecho se genera el {fmtFecha(saldo.proximo_aniversario)}.
            </p>
          )}

          <Row className="g-3 mb-3">
            <Col>
              <Form.Label>Desde *</Form.Label>
              <Form.Control type="date" name="fecha_inicio" value={form.fecha_inicio} onChange={cambiar} />
            </Col>
            <Col>
              <Form.Label>Hasta *</Form.Label>
              <Form.Control type="date" name="fecha_fin" min={form.fecha_inicio} value={form.fecha_fin} onChange={cambiar} />
            </Col>
          </Row>
          <p className="gp-muted small">Solo se descuentan los días en que el empleado trabaja según su horario (si no tiene horario, lunes a viernes).</p>
          <Form.Group>
            <Form.Label>Comentarios</Form.Label>
            <Form.Control as="textarea" rows={2} name="comentarios" value={form.comentarios} onChange={cambiar} maxLength={1000} />
          </Form.Group>
        </Modal.Body>
        <Modal.Footer>
          <Button variant="outline-secondary" onClick={() => setShowForm(false)} disabled={saving}>
            Cancelar
          </Button>
          <Button onClick={guardar} disabled={saving}>
            {saving ? <Spinner size="sm" /> : "Registrar"}
          </Button>
        </Modal.Footer>
      </Modal>

      <ResolverModal
        show={!!resolver}
        accion={resolver?.accion}
        busy={saving}
        resumen={
          resolver &&
          `${resolver.vacacion.empleado?.nombre_completo} · ${fmtRango(
            resolver.vacacion.fecha_inicio,
            resolver.vacacion.fecha_fin
          )} (${resolver.vacacion.dias} días laborables)`
        }
        onHide={() => setResolver(null)}
        onConfirm={confirmarResolver}
      />
    </div>
  );
}
</file>

