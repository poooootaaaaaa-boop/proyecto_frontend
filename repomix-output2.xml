  padding: 30px clamp(16px, 3vw, 40px) 56px;
  color: var(--ink);
}

.estancias-page button { font-family: inherit; }
.estancias-page button:focus-visible,
.estancias-page input:focus-visible { outline: 3px solid #a9dcd8; outline-offset: 2px; }

/* ---------- Encabezado ---------- */
.estancias-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
}
.estancias-kicker { display: inline-flex; align-items: center; gap: 7px; color: var(--teal); font-size: 11px; font-weight: 800; letter-spacing: 0.06em; }
.estancias-header h1 { margin: 6px 0 4px; font-size: clamp(22px, 3vw, 28px); line-height: 1.2; }
.estancias-header p { margin: 0; color: var(--muted); font-size: 14px; }

.estancias-refresh,
.estancias-report-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
