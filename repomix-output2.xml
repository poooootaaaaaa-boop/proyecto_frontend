.type-card.seguimiento.selected .type-title { color: var(--status-follow-text); }

/* Estado Urgente */
.type-card.urgente .type-dot { background-color: #dc2626; }
.type-card.urgente.selected {
  background-color: var(--status-urgent-bg);
  border-color: #dc2626;
}
.type-card.urgente.selected .type-title { color: var(--status-urgent-text); }

/* Picker y Resumen */
.picker-wrapper {
  display: flex;
  justify-content: center;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.summary-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

.summary-title {
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 0;
  margin-bottom: 16px;
  color: var(--brand-primary);
}

.summary-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 20px;
}

.summary-item {
  display: flex;
  justify-content: space-between;
