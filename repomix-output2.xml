import Table from 'react-bootstrap/Table';

function Datagrid({data=[], columns=[]}) {
    return (
        <Table striped bordered hover>
            <thead>
                <tr>
                    {
                    columns.map((columna, index) => <th key={index}>{columna}</th>)
                    }

                </tr>
            </thead>
            <tbody>
                {
                        (data.length == 0) ? <tr>
                            <td colSpan={columns.length}>No hay datos</td>
                            </tr> :
                        data.map((fila, index) => <tr key={index}>{
                            fila.map((campo, index) => <td key={index}>{campo}</td>)
                            }</tr>)
                    }
            </tbody>
        </Table>
        )
}
export default Datagrid;
</file>

<file path="src/pages/Medicos/Estancias.css">
.estancias-page {
  --ink: #12303a;
  --ink-soft: #3f5961;
  --muted: #6a7f87;
  --line: #dde7e9;
  --teal: #0d7772;
  --teal-dark: #095e5b;
  --teal-soft: #e6f3f1;
