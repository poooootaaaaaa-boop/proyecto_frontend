.type-card.rutina .type-title { color: var(--text-primary); }
.type-card.rutina.selected {
  background-color: var(--status-routine-bg);
  border-color: var(--brand-primary);
}
.type-card.rutina.selected .type-title { color: var(--status-routine-text); }

