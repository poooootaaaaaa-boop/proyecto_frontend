}

.badge-type {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 12px;
  text-transform: uppercase;
}

.badge-type.rutina { background: var(--status-routine-bg); color: var(--status-routine-text); }
.badge-type.seguimiento { background: var(--status-follow-bg); color: var(--status-follow-text); }
.badge-type.urgente { background: var(--status-urgent-bg); color: var(--status-urgent-text); }

.action-buttons-wrapper {
