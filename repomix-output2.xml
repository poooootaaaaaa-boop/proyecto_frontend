  border-top: 1px solid #eef2fa;
  padding: 16px 24px;
}

.modal-modern .btn-danger,
.modal-modern .btn-secondary {
  border-radius: 10px;
  font-weight: 600;
}

/* ========================================
   RESPONSIVE
======================================== */

@media (max-width: 768px) {
  .page-consultorio {
    padding: 15px;
  }

  .consultorio-header {
    padding: 20px;
  }

  .consultorio-header h2 {
