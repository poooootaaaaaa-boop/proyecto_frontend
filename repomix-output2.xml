/* ---------- Línea de tiempo ---------- */
.estancias-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.estancias-chips button { min-height: 40px; padding: 0 15px; color: var(--ink-soft); background: white; border: 1px solid var(--line); border-radius: 999px; font-size: 13px; font-weight: 700; cursor: pointer; }
