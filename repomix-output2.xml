}

/* ========================================
   TIPOS DE PAGO
======================================== */

.tipo-pago-card {
  background: white;
  border: 2px solid #e7ebf7;
  border-radius: 20px;
  text-align: center;
  padding: 25px 15px;
  cursor: pointer;
  transition: all .25s ease;
