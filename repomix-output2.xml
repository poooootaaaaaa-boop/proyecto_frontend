  gap: 12px;
  max-height: calc(100vh - 32px);
  padding: 14px;
  overflow: hidden auto;
  background: white;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.estancias-segmented { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; background: var(--wash); border-radius: 10px; }
.estancias-segmented button { min-height: 40px; border: 0; border-radius: 8px; color: var(--muted); background: transparent; font-size: 13px; font-weight: 700; cursor: pointer; }
.estancias-segmented button.is-on { color: var(--teal); background: white; box-shadow: 0 1px 3px rgba(18, 48, 58, 0.12); }

.estancias-search { position: relative; display: block; }
.estancias-search svg { position: absolute; top: 50%; left: 13px; color: var(--muted); transform: translateY(-50%); pointer-events: none; }
.estancias-search input { width: 100%; min-height: 44px; padding: 0 12px 0 38px; color: var(--ink); background: white; border: 1px solid #cad8db; border-radius: 10px; font: inherit; font-size: 14px; }
