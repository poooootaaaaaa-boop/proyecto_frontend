/* 
   CONTENEDOR PRINCIPAL (appointments)
 */

.appointments-container {
  padding: 40px;
  background-color: #f5f6fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* HEADER */

.appointments-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  flex-wrap: wrap;
  gap: 16px;
}

.title {
  font-weight: bold !important;
}

.subtitle {
  color: gray;
  font-size: 14px;
}

/* BOTÓN NUEVA CITA */

.new-btn {
  background-color: #2d4bb3 !important;
  color: white !important;
  border-radius: 25px !important;
  padding: 10px 20px !important;
  text-transform: none !important;
  transition: all 0.25s ease !important;
}

.new-btn:hover {
  background-color: #1f3a8a !important;
  transform: translateY(-1px);
}

/* 
   GRID / CONTENT
 */

.appointments-grid,
.appointments-content {
  display: flex;
  gap: 40px;
  align-items: flex-start;
}

/* LEFT SIDE */

.appointments-left {
  flex: 2;
}

.tabs {
  margin-bottom: 20px;
}

/* 
   CARD DE CITA
 */

.appointment-card {
  margin-bottom: 25px;
  border-left: 6px solid #2d4bb3;
  border-radius: 15px !important;
  transition: all 0.25s ease;
}

.appointment-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
}

.card-content-citas {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

/* AVATAR DOCTOR */

.doctor-avatar,
.card-content-citas .MuiAvatar-root {
  width: 60px !important;
  height: 60px !important;
}

/* INFO DOCTOR */

.doctor-info {
  flex: 1;
  min-width: 180px;
}

.doctor-name {
  font-weight: bold !important;
}

.specialty {
  color: #2d4bb3;
  font-size: 14px;
}

.details {
  color: gray;
  font-size: 13px;
}

/* ACCIONES */

.actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.reagendar-btn {
  background-color: #dfe6ec !important;
  color: black !important;
  text-transform: none !important;
  border-radius: 10px !important;
}

.cancelar-btn {
  background-color: #f5c2c2 !important;
  color: #d32f2f !important;
  text-transform: none !important;
  border-radius: 10px !important;
}

/* 
   RIGHT SIDE
 */

.appointments-right {
  flex: 1;
  min-width: 250px;
  margin-top: 55px; /* ajusta este valor */
}

.calendar {
  width: 100%;
  max-width: 100%;
  padding: 8px;
  border-radius: 15px !important;
  margin-bottom: 20px;
  box-sizing: border-box;
  overflow: hidden;
}

.calendar-title {
  font-weight: bold !important;
}

/* NOTES */

.notes {
  padding: 20px;
  border-radius: 15px !important;
  background-color: #fde8e8 !important;
}

.notes-title {
  font-weight: bold !important;
  margin-bottom: 10px;
}

.notes-text {
  color: #d32f2f;
  font-size: 13px;
}

/* 
   CONFIRM (lo mantengo pero aislado)
 */

.confirm-container {
  min-height: 100vh;
  background: #f5f6fa;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  box-sizing: border-box;
}

.confirm-card {
  width: 100%;
  max-width: 420px;
  border-radius: 20px !important;
  text-align: center;
  padding: 10px;
  transition: all 0.3s ease;
}

.confirm-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
}

.avatar {
  width: 90px !important;
  height: 90px !important;
  margin: 10px auto 20px auto !important;
  border: 4px solid #e3f2fd;
}

.info {
  color: #555;
  font-size: 14px;
  margin-bottom: 6px;
}

.confirm-btn {
  margin-top: 20px !important;
  background-color: #2d4bb3 !important;
  border-radius: 25px !important;
  padding: 12px !important;
  text-transform: none !important;
  font-weight: 600 !important;
  transition: all 0.25s ease !important;
}

.confirm-btn:hover {
  background-color: #1f3a8a !important;
  transform: translateY(-1px);
}


/* ===== CARD HISTORIAL ===== */
.history-card {
  position: relative;
  overflow: hidden;
}

/* contenedor header */
.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

/* ===== CHIP FINALIZADA ===== */
.finalizada-chip {
  background: linear-gradient(45deg, #00c853, #69f0ae) !important;
  color: white !important;
  font-weight: 600 !important;
  box-shadow: 0 0 8px rgba(0, 200, 83, 0.6);
  animation: sparkle 2s infinite ease-in-out;
}

/* ✨ DESTELLO */
@keyframes sparkle {
  0% {
    box-shadow: 0 0 6px rgba(0, 200, 83, 0.4);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 16px rgba(0, 200, 83, 0.9);
    transform: scale(1.05);
  }
  100% {
    box-shadow: 0 0 6px rgba(0, 200, 83, 0.4);
    transform: scale(1);
  }
}


/* Día completamente bloqueado */
.apv-day-cell.booked {
  background-color: #e5e7eb;      /* gris completo */
  border: 1px solid #d1d5db;
  cursor: not-allowed;
  opacity: 0.8;
  pointer-events: none;           /*  bloquea totalmente interacción */
}

/* número del día */
.apv-day-cell.booked .apv-day-number {
  color: #9ca3af;
  font-weight: 600;
}

/* quitar puntito azul si estaba */
.apv-day-cell.booked .apv-dot {
  display: none;
}

/* quitar hover */
.apv-day-cell.booked:hover {
  background-color: #e5e7eb;
  transform: none;
}

/* 
    RESPONSIVE
 */

@media (max-width: 900px) {
  .appointments-grid,
  .appointments-content {
    flex-direction: column;
  }

  .appointments-right {
  width: 100%;
  max-width: 350px;
}
}

@media (max-width: 480px) {
  .appointments-container {
    padding: 20px;
  }

  .appointments-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .avatar {
    width: 72px !important;
    height: 72px !important;
  }
}
