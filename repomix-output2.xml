.estancias-tabs em { min-width: 22px; padding: 1px 7px; color: inherit; background: rgba(13, 119, 114, 0.12); border-radius: 999px; font-style: normal; font-size: 11px; }
.estancias-tabs button.is-on em { background: rgba(255, 255, 255, 0.25); }

.estancias-stack { display: grid; gap: 14px; }

.estancias-current-box { padding: 14px 18px; background: var(--teal-soft); border-left: 4px solid var(--teal); border-radius: 0 10px 10px 0; }
.estancias-current-box.is-evolucion { background: #eef3f9; border-left-color: var(--blue); }
