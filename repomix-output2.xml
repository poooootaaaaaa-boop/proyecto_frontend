.confirm-container {
  width: 100%;
  min-height: 100vh;
  display: flex;
  justify-content: center; /* Centrado horizontal */
  align-items: center;     /* Centrado vertical (opcional, pero recomendado) */
  padding: 40px 20px;
  box-sizing: border-box;
}

.confirm-wrapper {
  width: 100%;
  max-width: 550px; /* Un ancho más estético para que no se vea estirado */
  margin: 0 auto;   /* Margen automático para asegurar centrado */
}

/* HEADER */
.confirm-header {
  text-align: center;
  margin-bottom: 30px;
}

.check-circle {
  display: inline-flex;
  background: rgba(16,185,129,0.1);
  padding: 20px;
  border-radius: 50%;
  margin-bottom: 16px;
}

.success-icon {
  font-size: 42px;
  color: #10b981;
}

.title {
  font-size: 28px !important;
  font-weight: 900 !important;
  color: #0f172a;
}

.subtitle {
  font-size: 14px;
  color: #64748b;
}

/* CARD */
.confirm-card {
  width: 100%;
  margin: 0 auto;
  border: 1px solid #f1f5f9 !important;
  border-radius: 24px !important;
  box-shadow:
    0 10px 25px -5px rgba(0,0,0,0.04),
    0 8px 10px -6px rgba(0,0,0,0.04);
  overflow: hidden;
}

/* DOCTOR */
.doctor-card {
  display: flex;
  gap: 20px;
  padding: 24px;
  border-bottom: 1px solid #f1f5f9;
  background: linear-gradient(
    90deg,
    rgba(19,91,236,0.03) 0%,
    transparent 100%
  );
}

.doctor-image {
  width: 90px !important;
  height: 90px !important;
  border-radius: 20px !important;
  border: 4px solid white;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

.rating-badge {
  position: absolute;
  bottom: -6px;
  right: -6px;
  background: white;
  padding: 3px 8px;
  border-radius: 20px;
