<file path="src/pages/farmacia/PruebaConsentimientoFirma.css">
@import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap");

.consent-page {
  --ink: #0e2a3b;
  --ink-soft: #46606f;
  --ink-mute: #7d929e;
  --teal: #0f766e;
  --teal-deep: #0b5a54;
  --teal-wash: #e3f2f0;
  --paper: #f3f6f6;
  --sheet: #ffffff;
  --line: #d9e3e6;
  --amber: #b45309;
  --amber-wash: #fef3e2;
  --coral: #c2410c;
  --coral-wash: #fdeae2;
  --ok: #047857;
  --ok-wash: #e6f6ee;
  --err: #b91c1c;
  --err-wash: #fdecec;

  min-height: 100vh;
  background: var(--paper);
  padding: 32px 20px 56px;
  display: flex;
  justify-content: center;
  font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--ink);
}

.consent-page *,
.consent-page *::before,
.consent-page *::after {
  box-sizing: border-box;
}

.consent-shell {
  width: 100%;
  max-width: 980px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* ---------- Header ---------- */
.consent-header {
  display: flex;
  align-items: center;
  gap: 14px;
}

.consent-header-icon {
  width: 46px;
  height: 46px;
  flex-shrink: 0;
  border-radius: 12px;
  background: var(--ink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.consent-header h2 {
  margin: 0;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.consent-header p {
  margin: 3px 0 0;
  font-size: 13.5px;
  color: var(--ink-soft);
  max-width: 64ch;
}

/* ---------- Layout con riel ---------- */
.consent-layout {
  display: grid;
  grid-template-columns: 210px minmax(0, 1fr);
  gap: 28px;
  align-items: start;
}

.consent-rail {
  position: sticky;
  top: 24px;
}

.consent-rail ol {
  list-style: none;
  margin: 0;
  padding: 0;
}

.consent-rail li {
  display: flex;
  gap: 12px;
  padding-bottom: 26px;
  position: relative;
  color: var(--ink-mute);
}

.consent-rail li:last-child {
  padding-bottom: 0;
}

.consent-rail li:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 13px;
  top: 28px;
  bottom: 2px;
  width: 2px;
  background: var(--line);
}

.consent-rail li.is-done:not(:last-child)::before {
  background: var(--teal);
}

.consent-rail-dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  background: var(--sheet);
  border: 2px solid var(--line);
  color: var(--ink-mute);
}

.consent-rail li.is-current .consent-rail-dot {
  border-color: var(--teal);
  color: var(--teal);
}

.consent-rail li.is-done .consent-rail-dot {
  background: var(--teal);
  border-color: var(--teal);
  color: #fff;
}

.consent-rail-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-top: 3px;
}

.consent-rail-text strong {
  font-size: 14px;
  font-weight: 600;
}

.consent-rail-text small {
  font-size: 12px;
  line-height: 1.35;
}

.consent-rail li.is-current .consent-rail-text strong,
.consent-rail li.is-done .consent-rail-text strong {
  color: var(--ink);
}

.consent-main {
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-width: 0;
}

/* ---------- Alertas ---------- */
.consent-alert {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 13.5px;
  border: 1px solid transparent;
}

.consent-alert.is-ok {
  background: var(--ok-wash);
  border-color: #b5e3cc;
  color: var(--ok);
}

.consent-alert.is-error {
  background: var(--err-wash);
  border-color: #f6c4c4;
  color: var(--err);
}

/* ---------- Hojas ---------- */
.consent-card {
  background: var(--sheet);
  border-radius: 14px;
  padding: 24px;
  border: 1px solid var(--line);
}

.consent-card-accent {
  border-color: var(--teal);
  box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.08);
}

.consent-card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.consent-card-header-split {
  justify-content: space-between;
}

.consent-card-header h3 {
  margin: 0;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.005em;
}

.consent-subtitle {
  margin: 26px 0 10px;
  font-size: 14px;
  font-weight: 600;
  color: var(--teal-deep);
}

.consent-subsection {
  margin: 26px 0 8px;
}

.consent-subsection .consent-subtitle {
  margin: 0;
}

.consent-tag {
  font-size: 12px;
  font-weight: 600;
  color: var(--teal-deep);
  background: var(--teal-wash);
  padding: 3px 10px;
  border-radius: 999px;
}

.consent-form {
  display: flex;
  flex-direction: column;
  gap: 26px;
}

.consent-fieldset {
  border: none;
  margin: 0;
  padding: 0;
  min-width: 0;
}

.consent-fieldset legend {
  padding: 0 0 12px;
  font-size: 13px;
  font-weight: 600;
  color: var(--teal-deep);
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  border-bottom: 1px solid var(--line);
  margin-bottom: 14px;
}

.consent-fieldset:disabled {
  opacity: 0.65;
}

.consent-count {
  background: var(--teal);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  border-radius: 999px;
  padding: 1px 8px;
}

.consent-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.consent-grid-spaced {
  margin-top: 18px;
}

.consent-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-soft);
}

.consent-full {
  grid-column: 1 / -1;
}

.consent-inline {
  display: flex;
  gap: 8px;
  align-items: stretch;
}

.consent-inline .consent-input {
  flex: 1;
  min-width: 0;
}

.consent-input {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 10px 12px;
  font-size: 14px;
  font-family: inherit;
  color: var(--ink);
  background: #f9fbfb;
  transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
}

.consent-input:focus {
  outline: none;
  border-color: var(--teal);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
}

textarea.consent-input {
  resize: vertical;
}

.consent-loading {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--ink-mute);
  padding: 10px 0;
}

/* ---------- Casillas ---------- */
.consent-check {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13.5px;
  font-weight: 500;
  color: var(--ink);
  cursor: pointer;
  line-height: 1.4;
}

.consent-check input {
  width: 16px;
  height: 16px;
  margin-top: 2px;
  flex-shrink: 0;
  accent-color: var(--teal);
}

.consent-check-block {
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #f9fbfb;
}

/* ---------- Marcadores del nuevo formato ---------- */
.consent-tokens {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.consent-tokens button {
  border: 1px solid var(--line);
  background: #fff;
  color: var(--teal-deep);
  border-radius: 6px;
  padding: 4px 9px;
  font-size: 12px;
  font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
  cursor: pointer;
}

.consent-tokens button:hover {
  background: var(--teal-wash);
  border-color: var(--teal);
}

/* ---------- Opciones de hospitalización ---------- */
.consent-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.consent-option {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  text-align: left;
  background: #f9fbfb;
  border: 1px solid var(--line);
  border-radius: 10px;
  cursor: pointer;
  font-family: inherit;
  color: var(--ink);
  transition: border-color 0.15s, background 0.15s;
}

.consent-option:hover {
  border-color: #a9c4c4;
}

.consent-option.is-selected {
  border-color: var(--teal);
  background: var(--teal-wash);
}

.consent-option-icon {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: var(--teal);
  border: 1px solid var(--line);
}

.consent-option.is-selected .consent-option-icon {
  background: var(--teal);
  color: #fff;
  border-color: var(--teal);
}

.consent-option-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.consent-option-text strong {
  font-size: 13.5px;
  font-weight: 600;
}

.consent-option-text small {
  font-size: 12px;
  color: var(--ink-soft);
  line-height: 1.3;
}

.consent-option-check {
  position: absolute;
  top: 8px;
  right: 8px;
  color: var(--teal);
}

/* ---------- Prioridad ---------- */
.consent-segmented {
  display: inline-flex;
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
  align-self: flex-start;
}

.consent-segmented button {
  border: none;
  background: #f9fbfb;
  padding: 9px 20px;
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  color: var(--ink-soft);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}

.consent-segmented button + button {
  border-left: 1px solid var(--line);
}

.consent-segmented button.is-normal.is-selected {
  background: var(--teal);
  color: #fff;
}

.consent-segmented button.is-urgent.is-selected {
  background: var(--amber);
  color: #fff;
}

.consent-segmented button.is-critical.is-selected {
  background: var(--coral);
  color: #fff;
}

/* ---------- Equipo de vigilancia ---------- */
.consent-chips {
  list-style: none;
  margin: 0 0 12px;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.consent-chips li {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 6px 4px 4px;
  background: var(--teal-wash);
  color: var(--teal-deep);
  border-radius: 999px;
  font-size: 13px;
  font-weight: 500;
}

.consent-chips button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: var(--teal-deep);
  cursor: pointer;
}

.consent-chips button:hover {
  background: rgba(15, 118, 110, 0.18);
}

.consent-avatar {
  width: 26px;
  height: 26px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  font-size: 10.5px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.consent-search {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #f9fbfb;
  color: var(--ink-mute);
  margin-bottom: 10px;
}

.consent-search:focus-within {
  border-color: var(--teal);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
}

.consent-search input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  padding: 10px 0;
  font-size: 14px;
  font-family: inherit;
  color: var(--ink);
}

.consent-doctor-list {
  list-style: none;
  margin: 0;
  padding: 0;
  max-height: 248px;
  overflow-y: auto;
  border: 1px solid var(--line);
  border-radius: 10px;
}

.consent-doctor-list li + li {
  border-top: 1px solid var(--line);
}

.consent-doctor-list button {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px 12px;
  background: #fff;
  border: none;
  text-align: left;
  font-family: inherit;
  color: var(--ink);
  cursor: pointer;
  transition: background 0.12s;
}

.consent-doctor-list button:hover {
  background: #f5f9f9;
}

.consent-doctor-list button.is-selected {
  background: var(--teal-wash);
}

.consent-doctor-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.consent-doctor-text strong {
  font-size: 13.5px;
  font-weight: 600;
}

.consent-doctor-text small {
  font-size: 12px;
  color: var(--ink-soft);
}

.consent-doctor-toggle {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-mute);
  background: #fff;
}

.consent-doctor-list button.is-selected .consent-doctor-toggle {
  background: var(--teal);
  border-color: var(--teal);
  color: #fff;
}

/* ---------- Firmas (clínica, doctor, paciente) ---------- */
.consent-slots {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.consent-slot {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px 14px;
  background: #fbfdfd;
}

.consent-slot.is-signed {
  border-color: #b5e3cc;
  background: #f6fcf9;
}

.consent-slot-head {
  display: flex;
  align-items: center;
  gap: 12px;
}

.consent-slot-icon {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 1px solid var(--line);
  color: var(--teal);
}

.consent-slot.is-signed .consent-slot-icon {
  background: var(--ok);
  border-color: var(--ok);
  color: #fff;
}

.consent-slot-title {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.consent-slot-title strong {
  font-size: 14px;
  font-weight: 600;
}

.consent-slot-title small {
  font-size: 12px;
  color: var(--ink-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.consent-slot-thumb {
  width: 150px;
  height: 52px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--line);
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
}

.consent-slot-thumb img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.consent-slot-thumb em {
  font-size: 12px;
  font-style: normal;
  color: var(--ink-mute);
}

.consent-slot-body {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
}

/* ---------- Botones ---------- */
.consent-btn-primary,
.consent-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 10px;
  padding: 11px 20px;
  font-size: 14px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.15s, border-color 0.15s;
}

.consent-btn-compact {
  padding: 9px 14px;
  font-size: 13px;
  white-space: nowrap;
}

.consent-btn-primary {
  background: var(--teal);
  color: #fff;
  border: 1px solid var(--teal);
}

.consent-btn-primary:hover {
  background: var(--teal-deep);
  border-color: var(--teal-deep);
}

.consent-btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.consent-btn-secondary {
  background: #fff;
  color: var(--ink);
  border: 1px solid var(--ink);
}

.consent-btn-secondary:hover {
  background: var(--paper);
}

.consent-btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 7px 14px;
  font-size: 12.5px;
  font-weight: 600;
  font-family: inherit;
  color: var(--ink-soft);
  cursor: pointer;
  white-space: nowrap;
}

.consent-btn-ghost:hover {
  background: var(--paper);
}

.consent-btn-primary:focus-visible,
.consent-btn-secondary:focus-visible,
.consent-btn-ghost:focus-visible,
.consent-option:focus-visible,
.consent-segmented button:focus-visible,
.consent-doctor-list button:focus-visible,
.consent-chips button:focus-visible,
.consent-tokens button:focus-visible {
  outline: 2px solid var(--teal);
  outline-offset: 2px;
}

.consent-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 4px;
}

/* ---------- Adjuntos ---------- */
.consent-files {
  list-style: none;
  margin: 0 0 12px;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 10px;
}

.consent-files li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  font-size: 13.5px;
  color: var(--ink-soft);
}

.consent-files li + li {
  border-top: 1px solid var(--line);
}

.consent-files a {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.consent-files small {
  color: var(--ink-mute);
  font-size: 12px;
}

.consent-files button {
  display: flex;
  border: none;
  background: transparent;
  color: var(--ink-mute);
  cursor: pointer;
  padding: 4px;
  border-radius: 6px;
}

.consent-files button:hover {
  color: var(--err);
  background: var(--err-wash);
}

.consent-upload {
  position: relative;
  cursor: pointer;
}

.consent-upload input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
}

.consent-upload.is-busy {
  opacity: 0.6;
  pointer-events: none;
}

/* ---------- Estado, historial ---------- */
.consent-badge {
  font-size: 12px;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: 999px;
}

.consent-badge.is-signed {
  background: var(--ok-wash);
  color: var(--ok);
}

.consent-badge.is-pending {
  background: var(--amber-wash);
  color: var(--amber);
}

.consent-empty {
  font-size: 13.5px;
  color: var(--ink-mute);
  margin: 4px 0 14px;
}

.consent-history {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}

.consent-history li {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
  font-size: 13.5px;
  color: var(--ink);
}

.consent-history li:last-child {
  border-bottom: none;
}

.consent-history-date {
  font-size: 12px;
  color: var(--ink-mute);
  white-space: nowrap;
}

.consent-hint {
  font-size: 12px;
  color: var(--ink-mute);
  margin: 12px 0 0;
  max-width: 70ch;
  line-height: 1.45;
}

.consent-hint-top {
  margin: 4px 0 0;
  font-weight: 400;
}

.spin {
  animation: consent-spin 0.8s linear infinite;
}

@keyframes consent-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .spin {
    animation-duration: 2s;
  }
  .consent-page * {
    transition: none !important;
  }
}

/* ---------- Responsive ---------- */
@media (max-width: 820px) {
  .consent-layout {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .consent-rail {
    position: static;
  }

  .consent-rail ol {
    display: flex;
    gap: 8px;
  }

  .consent-rail li {
    flex: 1;
    padding-bottom: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .consent-rail li:not(:last-child)::before {
    left: 34px;
    right: -8px;
    top: 13px;
    bottom: auto;
    width: auto;
    height: 2px;
  }

  .consent-rail-text small {
    display: none;
  }
}

@media (max-width: 560px) {
  .consent-page {
    padding: 20px 12px 40px;
  }

  .consent-card {
    padding: 18px;
  }

  .consent-grid,
  .consent-options {
    grid-template-columns: 1fr;
  }

  .consent-inline {
    flex-direction: column;
  }

  .consent-slot-head {
    flex-wrap: wrap;
  }

  .consent-slot-thumb {
    width: 100%;
    order: 3;
  }

  .consent-actions > * {
    width: 100%;
  }
}
