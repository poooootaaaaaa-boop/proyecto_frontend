.estancias-detail-empty { display: grid; place-content: center; justify-items: center; gap: 8px; min-height: 320px; padding: 24px; color: var(--muted); text-align: center; background: white; border: 2px dashed #cbd9dc; border-radius: var(--radius); font-size: 13px; }
