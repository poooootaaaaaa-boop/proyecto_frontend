                {/* Campo de Foto (Estilizado como la zona de arrastrar archivo de la imagen) */}
                {/* Campo de Foto */}
      <div style={{ marginBottom: '30px' }}>
          <label style={{ display: 'block', marginBottom: '8px', color: '#333333', fontSize: '13.5px', fontWeight: '500' }}>
