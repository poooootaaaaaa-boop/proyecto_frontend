}

.total-amount {
  font-size: 18px;
}

.status-selector-box {
  margin-bottom: 20px;
}

.select-label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: #475569;
  margin-bottom: 6px;
}

.custom-select-field {
  width: 100%;
  padding: 10px;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
