.estancias-entry-dot.is-procedimiento { background: var(--amber); }
.estancias-entry-dot.is-observacion { background: var(--blue); }
.estancias-entry-body { padding: 12px 14px; background: var(--wash); border-radius: 10px; }
.estancias-entry-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.estancias-entry-meta time { margin-left: auto; color: var(--muted); font-size: 11px; }
.estancias-entry-cost { color: var(--amber); font-size: 12px; font-weight: 800; }
.estancias-tag { padding: 3px 10px; color: var(--teal); background: var(--teal-soft); border-radius: 999px; font-size: 11px; font-weight: 800; }
.estancias-tag.is-procedimiento { color: var(--amber); background: #fbf0e0; }
.estancias-tag.is-observacion { color: var(--blue); background: #e8f0f8; }
.estancias-entry p { margin: 8px 0 6px; color: var(--ink-soft); font-size: 14px; line-height: 1.5; white-space: pre-wrap; }
.estancias-entry small { color: var(--muted); font-size: 11px; }

.estancias-spin { animation: estancia-spin 0.8s linear infinite; }
@keyframes estancia-spin { to { transform: rotate(360deg); } }

/* ---------- Tablet ---------- */
@media (max-width: 1050px) {
  .estancias-layout { grid-template-columns: 270px minmax(0, 1fr); gap: 14px; }
}

/* ---------- Móvil: lista y detalle como pantallas separadas ---------- */
@media (max-width: 860px) {
  .estancias-page { padding-top: 64px; }
  .estancias-header { align-items: flex-start; flex-direction: column; }
  .estancias-refresh { width: 100%; }
  .estancias-layout { grid-template-columns: 1fr; }
  .estancias-list-panel { position: static; max-height: none; }
  .estancias-layout.has-detail .estancias-list-panel { display: none; }
  .estancias-layout:not(.has-detail) .estancias-detail { display: none; }
  .estancias-back { display: inline-flex; justify-self: start; }
  .estancias-facts { grid-template-columns: 1fr; }
  .estancias-facts div { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .estancias-facts span { margin: 0; }
