}

/* ========================================
   TARJETAS DOCTORES (pago)
======================================== */

.doctor-card-pago {
  display: flex;
  align-items: center;
  gap: 20px;
  background: linear-gradient(135deg, #ffffff, #f4f9ff);
  border: 2px solid #dbeafe;
  border-radius: 20px;
  padding: 18px;
  cursor: pointer;
  transition: all .3s ease;
  position: relative;
  overflow: hidden;
}

.doctor-card-pago:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(37,99,235,.15);
}

.doctor-card-pago.selected {
  border-color: #2563eb;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  box-shadow: 0 10px 30px rgba(37,99,235,.25);
}

.doctor-photo {
  width: 90px;
  height: 90px;
