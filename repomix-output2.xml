/* ========================================
   PREVIEW DE CONSULTORIO (si se usa en otras vistas)
======================================== */

.consultorio-preview {
  background: white;
  border-radius: 20px;
  padding: 25px;
  text-align: center;
  box-shadow: 0 10px 30px rgba(0,0,0,.08);
}

.consultorio-preview h5 {
  font-weight: 700;
  color: #23335d;
  margin-bottom: 18px;
}

.consultorio-preview h6 {
  font-weight: 700;
