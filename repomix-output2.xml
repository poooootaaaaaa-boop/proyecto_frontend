<file path="src/pages/Medicos/AltaPacientes.css">
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

:root {
  --bg-app: #f8fafc;
  --surface-card: #ffffff;
  --border-subtle: #e2e8f0;

  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-tertiary: #94a3b8;

  --brand-primary: #2563eb;
  --brand-hover: #1d4ed8;
  --brand-light: #eff6ff;

  --radius-lg: 16px;
  --radius-md: 12px;
  --radius-sm: 8px;

  --shadow-card: 0 1px 3px 0 rgb(0 0 0 / 0.05), 0 1px 2px -1px rgb(0 0 0 / 0.05);
}

.alta-pacientes-wrapper {
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  background-color: var(--bg-app);
  padding: 24px;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Header */
.alta-header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--surface-card);
  padding: 20px 28px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-card);
  margin-bottom: 24px;
}

.header-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background-color: var(--brand-light);
  color: var(--brand-primary);
  font-size: 12px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
  margin-bottom: 6px;
}

.header-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0;
}

.header-subtitle {
  font-size: 13px;
  color: var(--text-secondary);
  margin: 4px 0 0 0;
}

.btn-back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--text-secondary) !important;
  font-weight: 600;
  font-size: 13px;
  text-decoration: none !important;
  padding: 8px 14px;
  border-radius: var(--radius-sm);
  background-color: #f1f5f9;
  transition: all 0.2s ease;
}

.btn-back-link:hover {
  background-color: #e2e8f0;
  color: var(--text-primary) !important;
}

/* Form Container */
.alta-form-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 1000px;
  margin: 0 auto;
}

/* Glass Card */
.glass-card {
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-card);
  padding: 24px;
}

.card-section-title {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.card-section-title .section-icon {
  color: var(--brand-primary);
  font-size: 26px;
}

.card-section-title h3 {
  font-size: 16px;
  font-weight: 700;
  margin: 0;
  color: var(--text-primary);
}

.card-section-title p {
  font-size: 12px;
  color: var(--text-secondary);
  margin: 2px 0 0 0;
}

/* Form Layout Grids */
.form-grid-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.form-grid-3col {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
}

@media (max-width: 768px) {
  .form-grid-2col, .form-grid-3col {
    grid-template-columns: 1fr;
  }
}

.field-group {
  display: flex;
  flex-direction: column;
}

.mt-3 {
  margin-top: 16px;
}

.custom-input-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.custom-input, .custom-select, .custom-textarea {
  width: 100%;
  padding: 10px 12px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  background-color: #f8fafc;
  font-family: inherit;
  font-size: 13px;
  outline: none;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.custom-input:focus, .custom-select:focus, .custom-textarea:focus {
  border-color: var(--brand-primary);
  background-color: #ffffff;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

/* Action Panel Buttons */
.action-panel {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 8px;
  margin-bottom: 30px;
}

.btn-cancel {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  background-color: #ffffff;
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  font-weight: 600;
  font-size: 13px;
  padding: 12px 24px;
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
}

.btn-cancel:hover {
  background-color: #f1f5f9;
  color: var(--text-primary);
}

.btn-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background-color: var(--brand-primary);
  border: none;
  color: #ffffff;
  font-weight: 600;
  font-size: 13px;
  padding: 12px 28px;
  border-radius: var(--radius-md);
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  transition: all 0.2s ease;
}

.btn-submit:hover {
  background-color: var(--brand-hover);
  transform: translateY(-1px);
}

.btn-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
/* Estilos para el Modal de Credenciales */
.credentials-modal-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 10px 4px;
}

.modal-icon-badge {
  background-color: var(--brand-light);
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.modal-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0;
}

.modal-description {
  font-size: 13px;
  color: var(--text-secondary);
  margin: 6px 0 20px 0;
}

/* Caja Credenciales */
.credentials-box {
  width: 100%;
  background-color: #f8fafc;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 14px;
  margin-bottom: 16px;
  box-sizing: border-box;
}

.cred-row {
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
}

.cred-icon {
  color: var(--brand-primary);
}

.cred-info {
  display: flex;
  flex-direction: column;
}

.cred-label {
  font-size: 11px;
  color: var(--text-tertiary);
  font-weight: 600;
  text-transform: uppercase;
}

.cred-value {
  font-size: 14px;
  color: var(--text-primary);
  font-family: monospace;
}

.cred-divider {
  height: 1px;
  background-color: var(--border-subtle);
  margin: 10px 0;
}

/* Botones Modal */
.btn-copy {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background-color: #ffffff;
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  padding: 10px;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-bottom: 10px;
}

.btn-copy:hover {
  background-color: #f1f5f9;
}

.btn-copy.copied {
  background-color: #dcfce7;
  border-color: #86efac;
  color: #166534;
}

.btn-accept-modal {
  width: 100%;
  background-color: var(--brand-primary);
  border: none;
  color: #ffffff;
  padding: 12px;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-accept-modal:hover {
  background-color: var(--brand-hover);
}
/* Indicadores visuales de validación */
.required-star {
  color: #ef4444;
  font-weight: 700;
  margin-left: 2px;
}

.optional-tag {
  color: #94a3b8;
  font-size: 11px;
  font-weight: 400;
  margin-left: 4px;
}

/* Estilos de error en inputs */
.custom-input.input-error,
.custom-select.input-error,
.custom-textarea.input-error {
  border-color: #ef4444 !important;
  background-color: #fef2f2 !important;
}

.custom-input.input-error:focus {
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15) !important;
}

.error-text {
  color: #ef4444;
  font-size: 11px;
  font-weight: 600;
  margin-top: 4px;
}
</file>

<file path="src/pages/Medicos/CrearCita.css">
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

:root {
