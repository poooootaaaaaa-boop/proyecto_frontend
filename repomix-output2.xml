}

.consultorio-box {
  width: 120px;
  height: 120px;
  margin: auto;
  border-radius: 20px;
  background: linear-gradient(135deg, #1f3fa3, #3458d4);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 35px;
  font-weight: bold;
