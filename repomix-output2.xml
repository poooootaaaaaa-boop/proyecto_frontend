function fmtFechaHora(f) {
  if (!f) return "-";
  const d = new Date(f);
  if (isNaN(d)) return f;
  return d.toLocaleString("es-MX", {
    day: "2-digit", month: "long", year: "numeric",
    hour: "2-digit", minute: "2-digit",
  });
}

