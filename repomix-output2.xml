/* ── Helpers ─────────────────────────────────────────────────────────────── */
function fmt(n) {
  return "$" + Number(n || 0).toLocaleString("es-MX", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}

function fmtFecha(f) {
  if (!f) return "-";
  // Acepta ISO o dd/mm/yyyy
  const d = new Date(f);
  if (isNaN(d)) return f;
  return d.toLocaleDateString("es-MX", { day: "2-digit", month: "long", year: "numeric" });
}

