.estancias-detail-empty strong { color: var(--ink); font-size: 16px; }

.estancias-back { display: none; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; color: var(--teal); background: white; border: 1px solid var(--line); border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; }

.estancias-patient-summary { display: grid; gap: 16px; padding: 18px; background: white; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
.estancias-summary-main { display: flex; align-items: center; gap: 14px; }
.estancias-summary-main h2 { margin: 0 0 5px; font-size: 20px; line-height: 1.2; }
.estancias-status { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; color: #8b4b19; background: #fbf0e4; border-radius: 999px; font-size: 12px; font-weight: 750; }
.estancias-status i { width: 7px; height: 7px; background: currentColor; border-radius: 50%; }
.estancias-status.is-active { color: #137455; background: #e4f5ec; }
.estancias-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.estancias-facts div { padding: 10px 12px; background: var(--wash); border-radius: 10px; }
.estancias-facts span { display: block; margin-bottom: 3px; color: var(--muted); font-size: 11px; }
.estancias-facts strong { font-size: 13px; }

/* ---------- Pestañas ---------- */
.estancias-tabs { position: sticky; top: 0; z-index: 5; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 5px; background: rgba(255, 255, 255, 0.96); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); backdrop-filter: blur(6px); }
.estancias-tabs button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; color: var(--muted); background: transparent; border: 0; border-radius: 9px; font-size: 14px; font-weight: 700; cursor: pointer; }
