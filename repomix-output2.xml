.rh-sec { background: #1a3a5c; color: #fff; font-size: 9px; font-weight: 700; padding: 3px 14px; text-transform: uppercase; letter-spacing: 0.5px; }

.rh-datos { display: flex; border-bottom: 1.5px solid #222; }
